javascript:(function(){if(document.getElementById('idle-seal-cheat-panel'))return;const STORE_KEY='idle_seal_mults_v2';const DEFAULTS={moveSpeed:5,gold:5,exp:5,dmg:5,respawn:5,fame:5,drop:5};function loadMults(){try{const s=localStorage.getItem(STORE_KEY);if(s)return Object.assign({},DEFAULTS,JSON.parse(s));}catch(e){}return Object.assign({},DEFAULTS);}function saveMults(m){try{localStorage.setItem(STORE_KEY,JSON.stringify(m));}catch(e){}}const TOGGLE_KEY='idle_seal_toggles_v1';const TOGGLE_DEFAULTS={skipEvolveMaterials:false,maxRefine:false};function loadToggles(){try{const s=localStorage.getItem(TOGGLE_KEY);if(s)return Object.assign({},TOGGLE_DEFAULTS,JSON.parse(s));}catch(e){}return Object.assign({},TOGGLE_DEFAULTS);}function saveToggles(t){try{localStorage.setItem(TOGGLE_KEY,JSON.stringify(t));}catch(e){}}let mults=loadMults();let toggles=loadToggles();let session=null;let patched=false;function looksLikeSession(obj){return obj&&typeof obj==='object'&&typeof obj.moveSpeed==='function'&&typeof obj.wornItems==='function'&&typeof obj.tick==='function';}function scanObjectGraph(root,maxDepth,maxNodes){const seen=new Set();const queue=[[root,0]];let count=0;while(queue.length){const[obj,depth]=queue.shift();if(!obj||typeof obj!=='object'||seen.has(obj))continue;seen.add(obj);count++;if(count>maxNodes)break;if(looksLikeSession(obj))return obj;if(depth>=maxDepth)continue;let keys;try{keys=Object.keys(obj);}catch(e){continue;}for(const k of keys){let v;try{v=obj[k];}catch(e){continue;}if(v&&typeof v==='object')queue.push([v,depth+1]);}}return null;}function findVueRoots(){const roots=[];const all=document.querySelectorAll('*');for(const el of all){for(const k of Object.keys(el)){if(k.indexOf('__vue')===0||k.indexOf('__vnode')===0){const v=el[k];if(v)roots.push(v);}}}return roots;}function locateSession(){if(window.__idleSealManualSession&&looksLikeSession(window.__idleSealManualSession)){return window.__idleSealManualSession;}const roots=findVueRoots();for(const r of roots){const found=scanObjectGraph(r,8,30000);if(found)return found;}return null;}function applyPatches(s){const proto=Object.getPrototypeOf(s);if(proto.__idleSealPatched)return;proto.__idleSealPatched=true;const origMoveSpeed=proto.moveSpeed;proto.moveSpeed=function(...args){const v=origMoveSpeed.apply(this,args);try{return Math.round(v*mults.moveSpeed);}catch(e){return v;}};if(typeof proto.expPerKill==='function'){const origExpPerKill=proto.expPerKill;proto.expPerKill=function(...args){const v=origExpPerKill.apply(this,args);try{return Math.max(1,Math.round(v*mults.exp));}catch(e){return v;}};}if(typeof proto.sellSweep==='function'){const origSellSweep=proto.sellSweep;proto.sellSweep=function(...args){let before=0;try{before=this.player?this.player.gold:0;}catch(e){}const result=origSellSweep.apply(this,args);try{if(this.player){const delta=this.player.gold-before;if(delta>0)this.player.gold+=Math.round(delta*(mults.gold-1));}}catch(e){}return result;};}if(typeof proto.tick==='function'){const origTick=proto.tick;proto.tick=function(...args){let atkBackup=null;try{if(this.battle&&Array.isArray(this.battle.units)&&mults.dmg>1){atkBackup=[];for(const u of this.battle.units){if(u.side==='ally'&&u.stats&&typeof u.stats.atk==='number'){atkBackup.push([u,u.stats.atk]);u.stats.atk=Math.round(u.stats.atk*mults.dmg);}}}}catch(e){atkBackup=null;}const result=origTick.apply(this,args);try{if(atkBackup){for(const[u,orig]of atkBackup){u.stats.atk=orig;}}}catch(e){}try{if(toggles.skipEvolveMaterials&&Array.isArray(this.pets)&&this.data&&this.data.petById){for(const p of this.pets){const def=this.data.petById.get(p.id);if(!def)continue;if(p.grow<9)p.grow=9;if(typeof def.feedFull==='number'&&p.exp<def.feedFull){p.exp=def.feedFull;}}}}catch(e){}return result;};}if(typeof proto.tickRespawns==='function'){const origTickRespawns=proto.tickRespawns;let lastRespawnTickAt=null;proto.tickRespawns=function(...args){const result=origTickRespawns.apply(this,args);try{const now=performance.now();const dt=lastRespawnTickAt===null?0:(now-lastRespawnTickAt);lastRespawnTickAt=now;if(mults.respawn>1&&dt>0&&Array.isArray(this.instances)){const extra=dt*(mults.respawn-1);for(const e of this.instances){if(!e.alive&&e.respawnMs>0){e.respawnMs=Math.max(0,e.respawnMs-extra);if(e.respawnMs<=0){e.alive=true;e.respawnMs=0;this.dirty=true;}}}}}catch(e){}return result;};}if(typeof proto.rewardKill==='function'&&typeof proto.give==='function'){const origRewardKill=proto.rewardKill;proto.rewardKill=function(...args){let before=null;try{if(this.drops&&typeof this.drops.forEach==='function'){before=new Map(this.drops);}}catch(e){}const result=origRewardKill.apply(this,args);try{if(before&&this.drops&&mults.drop>1){for(const[itemId,afterCount]of this.drops){const beforeCount=before.get(itemId)??0;const gained=afterCount-beforeCount;if(gained>0){const extra=Math.round(gained*(mults.drop-1));if(extra>0){this.give(itemId,extra);this.drops.set(itemId,(this.drops.get(itemId)??0)+extra);}}}}}catch(e){}return result;};}if(typeof proto.submitQuest==='function'){const origSubmitQuest=proto.submitQuest;proto.submitQuest=function(...args){let beforeCur=0,beforeTotal=0;try{if(this.player&&this.player.fame){beforeCur=this.player.fame.current;beforeTotal=this.player.fame.total;}}catch(e){}const result=origSubmitQuest.apply(this,args);try{if(this.player&&this.player.fame&&mults.fame>1){const deltaCur=this.player.fame.current-beforeCur;const deltaTotal=this.player.fame.total-beforeTotal;if(deltaCur>0)this.player.fame.current+=Math.round(deltaCur*(mults.fame-1));if(deltaTotal>0)this.player.fame.total+=Math.round(deltaTotal*(mults.fame-1));}}catch(e){}return result;};}if(typeof proto.buildPetView==='function'){const origBuildPetView=proto.buildPetView;proto.buildPetView=function(...args){const result=origBuildPetView.apply(this,args);try{if(toggles.skipEvolveMaterials&&result&&Array.isArray(result.targets)){for(const t of result.targets){t.blocked=false;if(typeof t.need==='number')t.have=t.need;}}}catch(e){}return result;};}if(typeof proto.countOf==='function'){const origCountOf=proto.countOf;proto.countOf=function(...args){if(toggles.skipEvolveMaterials)return Infinity;return origCountOf.apply(this,args);};}if(typeof proto.take==='function'){const origTake=proto.take;proto.take=function(...args){if(toggles.skipEvolveMaterials)return;return origTake.apply(this,args);};}if(typeof proto.evolvePet==='function'){const origEvolvePet=proto.evolvePet;proto.evolvePet=function(...args){try{return origEvolvePet.apply(this,args);}catch(e){return false;}};}if(typeof proto.refineStack==='function'){const origRefineStack=proto.refineStack;proto.refineStack=function(e){if(!toggles.maxRefine){return origRefineStack.call(this,e);}try{if(!this.inVillage)return;const t=this.player.stacks.get(e);if(!t||t.locked||!this.data.equipById.has(t.itemId))return;const name=typeof this.itemName==='function'?this.itemName(t.itemId):'裝備';t.refine=12;if(typeof this.push==='function')this.push(`${name} 精煉成功 → +12`,'equip');if(typeof this.cue==='function')this.cue('success');if(typeof this.refreshPlayerStats==='function')this.refreshPlayerStats();if(typeof this.applyNow==='function')this.applyNow();}catch(err){return origRefineStack.call(this,e);}};}console.log('[idle-seal 改機] 原型方法修補完成');}function tryPatchLoop(attemptsLeft){if(patched)return;const s=locateSession();if(s){session=s;window.__idleSealSession=s;applyPatches(s);patched=true;updateStatus('已找到並套用 (session 物件命中)');return;}if(attemptsLeft<=0){updateStatus('自動尋找失敗，請重新按鈕或確認畫面');return;}setTimeout(()=>tryPatchLoop(attemptsLeft-1),1000);}let statusEl=null;function updateStatus(text){if(statusEl)statusEl.textContent=text;}function buildPanel(){const panel=document.createElement('div');panel.id='idle-seal-cheat-panel';panel.style.cssText='position:fixed;top:80px;right:20px;z-index:999999;width:270px;max-height:calc(100vh - 100px);background:#1c1712;color:#eee;border:1px solid #4a3f33;border-radius:8px;font-family:-apple-system,"Microsoft JhengHei",sans-serif;font-size:13px;box-shadow:0 4px 16px rgba(0,0,0,.5);user-select:none;display:flex;flex-direction:column;overflow:hidden;';const header=document.createElement('div');header.style.cssText='padding:10px 12px;background:#2a221a;border-radius:8px 8px 0 0;cursor:move;font-weight:bold;border-bottom:1px solid #4a3f33;flex-shrink:0;display:flex;justify-content:space-between;align-items:center;';const headerTitle=document.createElement('span');headerTitle.textContent='放置希望 改機面板';header.appendChild(headerTitle);const collapseBtn=document.createElement('button');const COLLAPSE_KEY='idle_seal_panel_collapsed';let collapsed=false;try{collapsed=!!localStorage.getItem(COLLAPSE_KEY);}catch(e){}collapseBtn.textContent=collapsed?'▸':'▾';collapseBtn.style.cssText='background:transparent;border:1px solid #4a3f33;color:#eee;width:22px;height:22px;line-height:1;border-radius:4px;cursor:pointer;font-size:12px;flex-shrink:0;';header.appendChild(collapseBtn);panel.appendChild(header);const body=document.createElement('div');body.style.cssText='padding:12px;overflow-y:auto;flex:1;';if(collapsed)body.style.display='none';panel.appendChild(body);collapseBtn.addEventListener('click',(ev)=>{ev.stopPropagation();collapsed=!collapsed;body.style.display=collapsed?'none':'';collapseBtn.textContent=collapsed?'▸':'▾';try{localStorage.setItem(COLLAPSE_KEY,collapsed?'1':'');}catch(e){}});const fields=[{key:'moveSpeed',label:'移動速度倍率'},{key:'gold',label:'金錢倍率'},{key:'exp',label:'經驗倍率'},{key:'dmg',label:'傷害倍率(僅玩家)'},{key:'respawn',label:'怪物重生速度倍率'},{key:'fame',label:'名聲倍率(交任務時)'},{key:'drop',label:'掉寶倍率'}];fields.forEach(f=>{const row=document.createElement('div');row.style.cssText='margin-bottom:10px;';const labelRow=document.createElement('div');labelRow.style.cssText='display:flex;justify-content:space-between;margin-bottom:4px;';const labelText=document.createElement('span');labelText.textContent=f.label;const valText=document.createElement('span');valText.textContent=mults[f.key
